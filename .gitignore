# This repository intentionally publishes only the portfolio demo folder.
/*

# Keep this allow-list file.
!/.gitignore

# Keep only Assets/Demo and its Unity metadata.
!/Assets/
/Assets/*
!/Assets/Demo.meta
!/Assets/Demo/
!/Assets/Demo/**

# Keep the Lua/config baseline that ships with the player.
!/Assets/StreamingAssets.meta
!/Assets/StreamingAssets/
!/Assets/StreamingAssets/**
